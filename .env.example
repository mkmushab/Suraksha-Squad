# ============================================================================
# SURAKSHA SQUAD (TEAM MAA) — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy to `.env` for local execution (`cp .env.example .env`).
# Security Note: NEVER commit your real `.env` file to GitHub!
# ============================================================================

PORT=8000
SURAKSHA_ENV=development

# 1. ASI:One LLM API (`https://api.asi1.ai/v1/chat/completions`)
ASI1_API_KEY=your_asi1_api_key_here
ASI1_MODEL=asi1-mini
ASI1_BASE_URL=https://api.asi1.ai/v1

# 2. Context.dev MCP & Threat Context API (`https://api.context.dev/v1/search`)
CTX_API_KEY=your_context_dev_api_key_here
CONTEXT_DEV_API_KEY=your_context_dev_api_key_here
CONTEXT_DEV_URL=https://api.context.dev/v1/search

# 3. Fetch.ai Agentverse Mailbox & Almanac Registration Key
AGENTVERSE_API_KEY=your_agentverse_api_key_here

# 4. Optional Google Safe Browsing v4 Threat Feed Key
GOOGLE_SAFE_BROWSING_API_KEY=

# 5. Deterministic Seeds for All 12 Specialist uAgents (Derives 65-char `agent1q...` addresses)
SURAKSHA_CONCIERGE_SEED=replace_with_unique_seed_01
SURAKSHA_DOMAIN_SEED=replace_with_unique_seed_02
SURAKSHA_PAGE_SEED=replace_with_unique_seed_03
SURAKSHA_MESSAGE_SEED=replace_with_unique_seed_04
SURAKSHA_UPI_SEED=replace_with_unique_seed_05
SURAKSHA_GST_SEED=replace_with_unique_seed_06
SURAKSHA_PHONE_SEED=replace_with_unique_seed_07
SURAKSHA_EMAIL_SEED=replace_with_unique_seed_08
SURAKSHA_REPUTATION_SEED=replace_with_unique_seed_09
SURAKSHA_PATTERN_SEED=replace_with_unique_seed_10
SURAKSHA_SKEPTIC_SEED=replace_with_unique_seed_11
SURAKSHA_ACTION_SEED=replace_with_unique_seed_12
